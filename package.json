{
  "name": "@grafikr/theme-check-extension",
  "version": "1.1.0",
  "author": "Grafikr A/S",
  "description": "A set of opinionated checks for Shopify themes",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --packages external",
    "test": "bun test"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "onFail": "error"
    }
  },
  "engines": {
    "bun": ">=1.4.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/grafikr/theme-check-extension.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "recommended.yml"
  ],
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "@shopify/theme-check-common": "^3.24.0"
  }
}
